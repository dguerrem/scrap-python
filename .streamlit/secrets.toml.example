# Copiar estos valores de tu dashboard de Turso
# En Streamlit Cloud: Settings → Secrets → pegar el contenido

TURSO_DATABASE_URL = "libsql://tu-db-tu-org.turso.io"
TURSO_AUTH_TOKEN = "eyJ..."

# ---- Mailer (Fase 6) ----
# La contraseña de aplicación se genera en:
#   myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
# Son 16 caracteres. Nunca se guarda en la base de datos ni en el código.

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "info@psycoerp.es"
SMTP_APP_PASSWORD = "xxxxxxxxxxxxxxxx"
EMAIL_FROM_NAME = "Info | PsycoERP"
